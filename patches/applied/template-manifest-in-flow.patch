diff --git a/.github/workflows/claude-book.yml b/.github/workflows/claude-book.yml
index 2659c9c..6c2b6d5 100644
--- a/.github/workflows/claude-book.yml
+++ b/.github/workflows/claude-book.yml
@@ -250,23 +250,39 @@ jobs:
           git config user.name "github-actions[bot]"
           git config user.email "github-actions[bot]@users.noreply.github.com"
           git add $changed
-          git commit -m "Update code book (${{ inputs.scope || 'stale' }})"
+          # Repos that serve the manifest outputs from the repo root (the
+          # served-from-source and .NET shapes carry manifest.yml) get them
+          # regenerated into this same commit: a book run IS a manifest publish,
+          # so src-symbols.json can never lag the chapters and there is no
+          # separate "Update source manifest" step to remember. Build-pipeline
+          # repos keep theirs under dist/ via deploy.yml, dispatched below.
+          if [ -f "$GITHUB_WORKSPACE/.github/workflows/manifest.yml" ]; then
+            ( cd "$GITHUB_WORKSPACE" && MANIFEST_OUT_DIR=. MANIFEST_DETERMINISTIC=true \
+                MANIFEST_LANG='{{MANIFEST_LANG}}' MANIFEST_SRC_ROOT='{{MANIFEST_SRC_ROOT}}' \
+                node "{{WORKING_DIR}}/scripts/$MANIFEST_VARIANT" )
+            for f in src-manifest.json src-symbols.json src-tours.json src-book.json; do
+              [ -f "$GITHUB_WORKSPACE/$f" ] && git add "$GITHUB_WORKSPACE/$f"
+            done
+            echo "published=1" >> "$GITHUB_OUTPUT"
+          fi
+          git commit -m "Update code book (${{ inputs.scope || 'stale' }}) [skip ci]"
           git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git"
           git push origin HEAD:main
           echo "changed=1" >> "$GITHUB_OUTPUT"
 
-      # Republish src-book.json: manifest.yml on served-from-source and .NET
-      # repos, deploy.yml on build-pipeline repos. Whichever exists, once.
+      # Build-pipeline repos publish from dist/ via deploy.yml, which a
+      # GITHUB_TOKEN push does not trigger — dispatch it. Root-served repos
+      # already got their outputs in the commit above (published=1), so
+      # nothing is dispatched there (the commit carries [skip ci] for the same
+      # reason: manifest.yml would only regenerate byte-identical files).
       - name: Republish the manifest outputs
-        if: steps.commit.outputs.changed == '1'
+        if: steps.commit.outputs.changed == '1' && steps.commit.outputs.published != '1'
         env:
           GH_TOKEN: ${{ github.token }}
         run: |
-          for wf in manifest.yml deploy.yml; do
-            if [ -f ".github/workflows/$wf" ]; then
-              gh workflow run "$wf" --ref main
-              echo "Dispatched $wf"
-              exit 0
-            fi
-          done
-          echo "No manifest.yml or deploy.yml to dispatch — src-book.json republishes on the next push."
+          if [ -f ".github/workflows/deploy.yml" ]; then
+            gh workflow run deploy.yml --ref main
+            echo "Dispatched deploy.yml"
+          else
+            echo "No deploy.yml to dispatch — src-book.json republishes on the next push."
+          fi
diff --git a/.github/workflows/onboard.yml b/.github/workflows/onboard.yml
index e76400e..8911816 100644
--- a/.github/workflows/onboard.yml
+++ b/.github/workflows/onboard.yml
@@ -199,3 +199,27 @@ jobs:
             echo "claude-run.yml NOT found on ${TARGET_REPO}; the scaffold did not reach origin. See the onboard log above." >&2
             exit 1
           fi
+
+      # Bring the published manifest current. The scaffold commit above carries
+      # [skip ci], so the target's manifest.yml / deploy.yml did not run for it;
+      # dispatch whichever the target has, so src-symbols.json (which the book
+      # pass and the Structure tab both read) exists and matches the refreshed
+      # generator before anyone taps Generate. Best effort: a target whose
+      # workflow file is missing or not yet dispatchable just logs it.
+      - name: Publish the target's manifest outputs
+        if: ${{ inputs.preflight != 'true' }}
+        env:
+          GH_TOKEN: ${{ secrets.ONBOARD_PAT }}
+          TARGET_REPO: ${{ inputs.target_repo }}
+        run: |
+          for wf in manifest.yml deploy.yml; do
+            if gh api "repos/${TARGET_REPO}/contents/.github/workflows/${wf}" --jq .name >/dev/null 2>&1; then
+              if gh workflow run "$wf" -R "$TARGET_REPO" --ref main 2>/dev/null; then
+                echo "Dispatched ${wf} on ${TARGET_REPO}."
+              else
+                echo "Could not dispatch ${wf} on ${TARGET_REPO} (not yet indexed by Actions, or no workflow_dispatch) — it runs on the next push."
+              fi
+              exit 0
+            fi
+          done
+          echo "${TARGET_REPO} has no manifest.yml or deploy.yml — nothing to publish."
