+      - name: Publish manifest outputs to gh-pages (.NET shapes)
+        if: steps.commit.outputs.published == '1'
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+          MANIFEST_LANG: '{{MANIFEST_LANG}}'
+        run: |
+          set -euo pipefail
+          if [ "$MANIFEST_LANG" != "csharp" ]; then
+            echo "Not a .NET shape — Pages serves this repo from where it always has."
